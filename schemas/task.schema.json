{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-outfitter.dev/schemas/evals-task/v2",
  "title": "Evals task",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "kind", "prompt", "metrics", "untrusted"],
  "properties": {
    "schema_version": {"const": 2},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "kind": {"type": "string", "minLength": 1},
    "fixture": {"type": "string", "description": "Relative path to a fixture repo dir (worktree kinds)"},
    "input": {"type": "string", "description": "Relative path to an input file (transform kinds)"},
    "prompt": {"type": "string", "minLength": 1},
    "evaluator": {"type": "string", "description": "Relative path to a deterministic evaluator script"},
    "evaluator_format": {"enum": ["json", "unittest"], "default": "json"},
    "metrics": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "untrusted": {"const": true}
  }
}
