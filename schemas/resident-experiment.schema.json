{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "timeout_seconds", "variants", "documents", "prompts", "rubric"],
  "properties": {
    "version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
    "timeout_seconds": {"type": "integer", "minimum": 30, "maximum": 1800},
    "model_settings": {"type": "object", "additionalProperties": false, "properties": {
      "thinking": {"enum": ["off", "minimal", "low", "medium", "high"]},
      "thinking_format": {"enum": ["openai", "zai", "qwen-chat-template"]},
      "max_tokens": {"type": "integer", "minimum": 256, "maximum": 32768}}},
    "variants": {"type": "array", "uniqueItems": true, "minItems": 1, "items": {"enum": ["baseline", "retrieval", "collaboration"]}},
    "documents": {"type": "array", "minItems": 2, "maxItems": 2, "items": {
      "type": "object", "additionalProperties": false, "required": ["key", "actor", "kind", "role"],
      "properties": {"key": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"}, "actor": {"enum": ["luce", "vega"]},
        "kind": {"enum": ["product_roadmap_lifecycle", "engineering_tech_stack_strategy"]}, "role": {"enum": ["cpo", "cto"]}}
    }},
    "prompts": {"type": "object", "additionalProperties": false,
      "required": ["charter", "draft", "request_input", "review", "revise"],
      "properties": {"charter": {"type": "string", "minLength": 1}, "draft": {"type": "string", "minLength": 1},
        "request_input": {"type": "string", "minLength": 1}, "review": {"type": "string", "minLength": 1}, "revise": {"type": "string", "minLength": 1}}},
    "rubric": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
